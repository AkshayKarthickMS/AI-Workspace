# Public host ports
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
OLLAMA_PORT=11434
REDIS_PORT=6379
LANGFUSE_PORT=3001

# Server-side URL used by the Next.js rewrite. In Docker this is overridden.
API_INTERNAL_URL=http://localhost:8000

# API configuration
AEGIS_ENVIRONMENT=development
AEGIS_LOG_LEVEL=INFO
AEGIS_CORS_ORIGINS=http://localhost:3000

# Local PostgreSQL configuration (reserved for the persistence implementation)
POSTGRES_DB=aegisos
POSTGRES_USER=aegisos
POSTGRES_PASSWORD=change-me-for-local-development

# SQLAlchemy DSN the API uses to reach the database above (psycopg v3 driver).
# Outside Docker this points at localhost; docker-compose.yml overrides the
# host to the `postgres` service name.
AEGIS_DATABASE_URL=postgresql+psycopg://aegisos:change-me-for-local-development@localhost:5432/aegisos

# Redis: ephemeral event-bus/SSE fan-out only, never a system of record.
AEGIS_REDIS_URL=redis://localhost:6379/0

# Where the Analyst agent's tabular tool and the artifact store read/write,
# relative to the process working directory. This default assumes uvicorn is
# run from apps/api (the documented local-dev command); docker-compose.yml
# overrides both to be relative to the container's /app instead.
AEGIS_DATA_ROOT=../../data/demo
AEGIS_ARTIFACT_ROOT=../../data/artifacts

# Model provider selection (see AGENTS.md - local/open-weight models only).
# AEGIS_MODEL_PROVIDER is "ollama" or "huggingface".
AEGIS_MODEL_PROVIDER=ollama
AEGIS_MODEL_NAME=qwen2.5:7b-instruct
AEGIS_EMBEDDING_MODEL_NAME=nomic-embed-text
AEGIS_OLLAMA_BASE_URL=http://localhost:11434
# Local OpenAI-chat-compatible endpoint (TGI/vLLM/llama.cpp server), only used
# when AEGIS_MODEL_PROVIDER=huggingface.
AEGIS_HUGGINGFACE_ENDPOINT_URL=http://localhost:8080

# Sandboxed code execution limits (Analyst agent, ARCHITECTURE.md §10/§12)
AEGIS_SANDBOX_TIMEOUT_SECONDS=30
AEGIS_SANDBOX_MEMORY_LIMIT_MB=512
AEGIS_SANDBOX_CPU_LIMIT=1.0

# Self-hosted Langfuse tracing (optional `observability` Compose profile).
# Reserved for the Langfuse client wiring; leave the keys blank until a
# project is created in the local Langfuse instance.
LANGFUSE_DB_PASSWORD=change-me-for-local-development
LANGFUSE_NEXTAUTH_SECRET=change-me-for-local-development
LANGFUSE_SALT=change-me-for-local-development
LANGFUSE_ENCRYPTION_KEY=change-me-32-byte-hex-for-local-development
AEGIS_LANGFUSE_HOST=http://localhost:3001
AEGIS_LANGFUSE_PUBLIC_KEY=
AEGIS_LANGFUSE_SECRET_KEY=
